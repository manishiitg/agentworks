{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "diagram": {
      "description": "A flow or architecture with themed nodes and connectors.",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "direction": {
          "default": "vertical",
          "type": "string",
          "enum": [
            "vertical",
            "horizontal"
          ]
        },
        "nodes": {
          "minItems": 1,
          "maxItems": 16,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 48,
                "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 280
              },
              "emphasis": {
                "type": "boolean"
              },
              "items": {
                "minItems": 1,
                "maxItems": 6,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "title": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80
                    },
                    "description": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 160
                    }
                  },
                  "required": [
                    "title"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "id",
              "title"
            ],
            "additionalProperties": false
          }
        },
        "edges": {
          "default": [],
          "maxItems": 24,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "from": {
                "type": "string",
                "minLength": 1,
                "maxLength": 48,
                "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
              },
              "to": {
                "type": "string",
                "minLength": 1,
                "maxLength": 48,
                "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "bidirectional": {
                "type": "boolean"
              }
            },
            "required": [
              "from",
              "to"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "title",
        "nodes"
      ],
      "additionalProperties": false
    },
    "chart": {
      "description": "A compact line or bar chart of observed numbers.",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "style": {
          "type": "string",
          "enum": [
            "line",
            "bar"
          ]
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "data": {
          "minItems": 1,
          "maxItems": 30,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "value": {
                "type": "number",
                "minimum": -1000000000000000,
                "maximum": 1000000000000000
              }
            },
            "required": [
              "label",
              "value"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "title",
        "style",
        "data"
      ],
      "additionalProperties": false
    },
    "timeline": {
      "description": "Saved events in supplied order.",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "items": {
          "minItems": 1,
          "maxItems": 20,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "when": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "detail": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1500
              }
            },
            "required": [
              "when",
              "title"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "title",
        "items"
      ],
      "additionalProperties": false
    },
    "cards": {
      "description": "Image and text options in list or grid layout.",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "layout": {
          "default": "list",
          "type": "string",
          "enum": [
            "list",
            "grid"
          ]
        },
        "items": {
          "minItems": 1,
          "maxItems": 12,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "image": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2048
                  },
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2048
                  }
                ]
              },
              "href": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              }
            },
            "required": [
              "title"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "title",
        "items"
      ],
      "additionalProperties": false
    },
    "sequence": {
      "description": "Specialist visual for ordered calls and replies between participants.",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "participants": {
          "minItems": 1,
          "maxItems": 6,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 48,
                "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              }
            },
            "required": [
              "id",
              "title"
            ],
            "additionalProperties": false
          }
        },
        "messages": {
          "minItems": 1,
          "maxItems": 24,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "from": {
                "type": "string",
                "minLength": 1,
                "maxLength": 48,
                "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
              },
              "to": {
                "type": "string",
                "minLength": 1,
                "maxLength": 48,
                "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "reply": {
                "type": "boolean"
              }
            },
            "required": [
              "from",
              "to",
              "label"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "title",
        "participants",
        "messages"
      ],
      "additionalProperties": false
    },
    "swimlane": {
      "description": "Specialist visual for who does each step, grouped into lanes.",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "lanes": {
          "minItems": 1,
          "maxItems": 6,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 48,
                "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              }
            },
            "required": [
              "id",
              "title"
            ],
            "additionalProperties": false
          }
        },
        "steps": {
          "minItems": 1,
          "maxItems": 16,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 48,
                "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
              },
              "lane": {
                "type": "string",
                "minLength": 1,
                "maxLength": 48,
                "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 280
              }
            },
            "required": [
              "id",
              "lane",
              "title"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "title",
        "lanes",
        "steps"
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "minProperties": 1,
  "maxProperties": 1
}
