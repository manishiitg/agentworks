{
  "name": "runloop-desktop",
  "version": "1.25.143",
  "description": "Standalone Mac app for AgentWorks",
  "repository": "github:manishiitg/agentworks",
  "main": "main.js",
  "private": true,
  "scripts": {
    "test": "node --test lib/*.test.js",
    "start": "npx electron .",
    "build": "electron-builder --mac --dir",
    "dist": "electron-builder --mac --publish always"
  },
  "build": {
    "appId": "com.mcp-agent-builder.desktop",
    "productName": "AgentWorks",
    "publish": [
      "github"
    ],
    "mac": {
      "icon": "resources/icons/icon.png",
      "category": "public.app-category.developer-tools",
      "identity": null,
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "extraResources": [
        {
          "from": "resources/agent-server",
          "to": "agent-server"
        },
        {
          "from": "resources/workspace-server",
          "to": "workspace-server"
        },
        {
          "from": "resources/lib",
          "to": "lib"
        },
        {
          "from": "resources/bin",
          "to": "bin"
        },
        {
          "from": "resources/install.sh",
          "to": "install.sh"
        },
        {
          "from": "resources/tmux-build.json",
          "to": "tmux-build.json"
        },
        {
          "from": "resources/voice",
          "to": "voice"
        }
      ]
    },
    "extraResources": [
      {
        "from": "resources/icons",
        "to": "icons"
      },
      {
        "from": "../agent_go/configs",
        "to": "configs"
      },
      {
        "from": "../agent_go/static",
        "to": "static"
      },
      {
        "from": "resources/licenses",
        "to": "licenses"
      }
    ],
    "files": [
      "main.js",
      "preload.js",
      "walkthroughState.js",
      "lib/*.js",
      "!lib/*.test.js",
      "settings.html",
      "auth-prompt.html"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icons/icon.png",
      "artifactName": "${productName}-${version}-win-${arch}.${ext}",
      "extraResources": [
        {
          "from": "resources/win/agent-server.exe",
          "to": "agent-server.exe"
        },
        {
          "from": "resources/win/workspace-server.exe",
          "to": "workspace-server.exe"
        },
        {
          "from": "resources/win/bin",
          "to": "bin"
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}"
    }
  },
  "dependencies": {
    "detect-port": "^1.5.1"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  }
}
