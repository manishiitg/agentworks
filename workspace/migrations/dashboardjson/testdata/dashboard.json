{
  "root": "page",
  "elements": {
    "page": {
      "type": "Stack",
      "props": {
        "gap": "lg",
        "className": "authored-layout"
      },
      "children": [
        "title",
        "metric",
        "chart",
        "controls",
        "filter",
        "details-button",
        "details",
        "script",
        "ask",
        "function",
        "refresh"
      ]
    },
    "title": {
      "type": "Heading",
      "props": {
        "text": "Recorded sales",
        "level": "h1"
      },
      "children": []
    },
    "metric": {
      "type": "Metric",
      "props": {
        "label": "Recorded total",
        "value": {
          "$state": "/summary/total"
        }
      },
      "children": []
    },
    "chart": {
      "type": "LineChart",
      "props": {
        "label": "Sales history",
        "data": {
          "$state": "/series"
        },
        "progress": {
          "$state": "/playback/progress"
        }
      },
      "children": []
    },
    "controls": {
      "type": "MotionControls",
      "props": {},
      "children": []
    },
    "filter": {
      "type": "Input",
      "props": {
        "label": "Filter",
        "name": "filter",
        "value": {
          "$bindState": "/filter"
        }
      },
      "children": []
    },
    "details-button": {
      "type": "Button",
      "props": {
        "label": "Show details"
      },
      "on": {
        "press": {
          "action": "setState",
          "params": {
            "statePath": "/details",
            "value": true
          }
        }
      },
      "children": []
    },
    "details": {
      "type": "Text",
      "props": {
        "text": "Recorded values only"
      },
      "visible": {
        "$state": "/details",
        "eq": true
      },
      "children": []
    },
    "script": {
      "type": "Text",
      "props": {
        "text": {
          "$state": "/script/marker"
        }
      },
      "children": []
    },
    "ask": {
      "type": "AskButton",
      "props": {
        "label": "Ask about this"
      },
      "children": []
    },
    "function": {
      "type": "FunctionButton",
      "props": {
        "name": "lookup",
        "label": "Look up"
      },
      "children": []
    },
    "refresh": {
      "type": "Button",
      "props": {
        "label": "Refresh data"
      },
      "on": {
        "press": {
          "action": "refreshData",
          "params": {}
        }
      },
      "children": []
    }
  },
  "state": {
    "filter": "",
    "summary": {
      "total": 0
    },
    "series": [],
    "script": {
      "marker": ""
    },
    "details": false,
    "text": "</script><script>alert(1)</script>"
  },
  "data": [
    {
      "statePath": "/series",
      "method": "query",
      "sql": "SELECT label, value FROM recorded_sales ORDER BY label",
      "params": []
    },
    {
      "statePath": "/summary",
      "method": "get",
      "path": "db/summary.json"
    },
    {
      "statePath": "/script",
      "method": "run",
      "path": "{{dashboard_scripts}}/summary.py",
      "args": {}
    }
  ],
  "motion": {
    "duration": 2,
    "statePath": "/playback"
  },
  "styles": ".authored-layout{max-width:900px;margin:auto;padding:24px} @media(max-width:600px){.authored-layout{padding:12px}}"
}
