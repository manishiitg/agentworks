{
  "modules": ["./messages.js"],
  "hooks": {
    "UserPromptExpansion": [
      {
        "matcher": "^(agentworks|agentworks:agentworks)$",
        "hooks": [
          {
            "type": "command",
            "command": "agentworks plugin hook claude",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "agentworks plugin hook claude",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "agentworks plugin hook claude",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "agentworks plugin hook claude",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "agentworks plugin hook claude",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
