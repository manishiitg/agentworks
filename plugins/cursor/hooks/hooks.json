{
  "version": 1,
  "hooks": {
    "beforeSubmitPrompt": [
      {
        "command": "python3 \"${CURSOR_PLUGIN_ROOT}/scripts/cursor_hook.py\"",
        "timeout": 20
      }
    ],
    "stop": [
      {
        "command": "python3 \"${CURSOR_PLUGIN_ROOT}/scripts/cursor_hook.py\"",
        "timeout": 20,
        "loop_limit": 5
      }
    ],
    "sessionEnd": [
      {
        "command": "python3 \"${CURSOR_PLUGIN_ROOT}/scripts/cursor_hook.py\"",
        "timeout": 20
      }
    ]
  }
}
