{
  "version": 1,
  "hooks": {
    "beforeSubmitPrompt": [
      {
        "command": "agentworks plugin hook cursor",
        "timeout": 20
      }
    ],
    "stop": [
      {
        "command": "agentworks plugin hook cursor",
        "timeout": 20,
        "loop_limit": 5
      }
    ],
    "sessionEnd": [
      {
        "command": "agentworks plugin hook cursor",
        "timeout": 20
      }
    ],
    "sessionStart": [
      {
        "command": "agentworks plugin hook cursor",
        "timeout": 20
      }
    ],
    "postToolUse": [
      {
        "command": "agentworks plugin hook cursor",
        "timeout": 20
      }
    ]
  }
}
