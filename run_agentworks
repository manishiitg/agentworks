#!/usr/bin/env bash
# AgentWorks local launcher.
#
# Runs the local stack (agent + workspace + frontend + Electron):
#   ./run_agentworks
#
# All arguments are forwarded to agent_go/run_server_with_logging.sh, so
# partial stacks and modifiers work too, e.g.:
#   ./run_agentworks --only-backend          # agent + workspace, no frontend (alias of --with-workspace)
#   ./run_agentworks --only-frontend         # frontend only
#   ./run_agentworks --only-frontend --debug-memory  # + heap snapshots (:9333) & RSS log
#   ./run_agentworks --only-gateway          # standalone server gateway development
#   ./run_agentworks --background            # full stack, detached
#   ./run_agentworks --help                  # all options
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
exec "$SCRIPT_DIR/agent_go/run_server_with_logging.sh" "$@"
