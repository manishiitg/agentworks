# Confida deployment config. The shared rootless Linux deployer reads this
# file both locally and from the freshly cloned checkout on the server.

PRODUCT=confida
HOST_IP="${HOST_IP:-116.202.210.102}"
SSH_PORT="${SSH_PORT:-2299}"
SSH_KEY_PATH="${SSH_KEY_PATH:-$HOME/.ssh/confida_deploy}"
DOMAIN="confida.agentworkshq.com"

AGENT_PORT=22000
WORKSPACE_PORT=22001
VAULT_ENABLED=true
VAULT_PORT=22003
GATEWAY_ADDR="127.0.0.1:22080"

AGENT_PRODUCTS="agentworks,work,code,mcp-gateway,knowledgebase"
AGENT_PROVIDER="vertex"
AGENT_MODEL="gemini-3.8-flash"
AGENT_MAX_TURNS=100

# Confida exposes every supported coding-agent provider.
# Agy uses the existing service GEMINI_API_KEY, without a Google login.
AGY_AUTH_MODE=gemini

# Own the runtime instead of inheriting another product's host Node install.
PIN_NODE_VERSION="24.21.0"
PIN_NODE_SHA256="fd8e59d5a511510f6a298afb548f18c7d2b1be404d8b4a27d94fbe49f56cb2d6"

COPY_PLAYBOOKS=true
PLAYBOOK_SMOKE_PATH="agentic-engineering-platform/browser-qa/basic-browser-setup/playbook.json"
RUN_WORKFLOW_BUILDER_MIGRATION=true
PERSIST_MCP_STATE=true

EXPECTED_PUBLIC_URL="https://confida.agentworkshq.com"
PUBLIC_HEALTH_STATUS=200
PUBLIC_CHECK_PATHS=("/login")

# The deployer persists these exact non-secret settings in .env and verifies
# both the agent and workspace process environments after restart.
EXTRA_ENV=(
  # PLAT-364: every coding CLI runs under the Landlock lock, with Full CLI inside it.
  "AGENT_BROWSER_CDP_ENABLED=false"
  "AGENTWORKS_BROWSER_SESSION_PREFIX=confida"
  # Outside MCP connections may edit Builder plans/code and write Relays (owner 2026-10-05); per-person limits unchanged (PLAT-487).
  "AGENTWORKS_MCP_BUILDER_ENABLED=true"
  # New Crews are created at the shared Crew/ root, from the UI too (owner 2026-10-05, PLAT-442).
  "AGENTWORKS_CREW_SHARED_ROOT=on"
  "AGENTWORKS_BROWSER_STAGING_NAMESPACE=confida"
  "DISPLAY_TIME_ZONE=America/New_York"
  "AGENTWORKS_ADMIN_ONLY_PRODUCT_SURFACES="
  "AGENTWORKS_PRODUCTS_AVAILABLE_TO_ALL=work,code,relays"
  # Per-user Linux accounts, opt-in: a user who holds a slot runs shell commands as it, everyone else is
  # unchanged (Confida runs Workflows and Crews whose shared folders are not slot-writable yet). Confida
  # shares the host with other products, so it has its own accounts (cf01..), launcher, config and table:
  # deploy/common/provision-slots.sh with PRODUCT=confida SLOT_PREFIX=cf SLOT_COUNT=15.
  "AGENTWORKS_SLOTS=optin"
  "AGENTWORKS_SLOT_PREFIX=cf"
  "AGENTWORKS_SLOTCTL=/usr/local/libexec/agentworks/confida/slotctl"
  "AGENTWORKS_SLOTCTL_CONFIG=/usr/local/libexec/agentworks/confida/slotctl.json"
  "AGENTWORKS_SLOTS_FILE=/etc/agentworks/confida/slots.json"
)

# Put the tmux front-end for slots first in PATH (it leaves every session that is not a slot's alone).
SLOTS_ENABLED=true

# These paths are consumed by the agent only. Keep them out of the workspace
# unit while still verifying the live agent received them.
AGENT_EXTRA_ENV=(
  # Server temp files (launch scripts, CLI configs, bridge tokens) stay out
  # of the shared /tmp, which coding CLIs may write; tmux stays in /tmp.
  "TMPDIR=/srv/confida/state/agent-tmp"
  "TMUX_TMPDIR=/tmp"
  "AGENTWORKS_PLAYBOOKS_DIR=/srv/confida/current/playbooks"
  "AGENTWORKS_MCP_STATE_DIR=/srv/confida/state/mcp"
)

# Delete obsolete Confida-specific overrides once the shared managed drop-in
# has replaced them.
REMOVE_DEPLOY_DROPINS=("60-admin-only-products.conf")

RUNTIME_CONFIG_REQUIRED_SNIPPETS=(
  "cdpEnabled: false"
  "gatewayUrl: \"https://confida.agentworkshq.com\""
  "enabledProductSurfaces: [\"agentworks\", \"relays\", \"work\", \"code\", \"mcp-gateway\", \"knowledgebase\"]"
  "defaultProductSurface: \"agentworks\""
  "appName: \"Confida\""
  "markUrl: \"/brand/icon.svg\""
)
