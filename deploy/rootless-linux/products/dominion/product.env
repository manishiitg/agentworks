# trader.tectonicmarkets.com: Dominion (the day-trading product) on the shared rootless host, next to Excellence,
# Confida and SparkQuill. Deployed like them since 2026-10-07 (owner: "everything same as excellence/confida"),
# from the one shared build; before that it had its own deploy (deploy/dedicated-vm/deploy-dominion.sh).
# It is the owner's testing ground: changes go here first.
PRODUCT=dominion
HOST_IP="${HOST_IP:-116.202.210.102}"
SSH_PORT="${SSH_PORT:-2299}"
SSH_KEY_PATH="${SSH_KEY_PATH:-$HOME/.ssh/id_ed25519}"
DOMAIN="trader.tectonicmarkets.com"
AGENT_PORT=21000
WORKSPACE_PORT=21001
# Vault uses the shared private service/bootstrap lifecycle (PLAT-646).
VAULT_ENABLED=true
VAULT_PORT=21003
GATEWAY_ADDR="127.0.0.1:21080"
AGENT_PRODUCTS="dominion,agentworks,work,code,relays,mcp-gateway,knowledgebase"
AGENT_MAX_TURNS=100
PIN_NODE_VERSION=""
COPY_PLAYBOOKS=false
RUN_WORKFLOW_BUILDER_MIGRATION=false
PERSIST_MCP_STATE=true
EXPECTED_PUBLIC_URL="https://trader.tectonicmarkets.com"
PUBLIC_HEALTH_STATUS=200
PUBLIC_CHECK_PATHS=("/login")
EXTRA_ENV=(
  # EnvironmentFile wins over unit settings; replace the old native deploy allowlist.
  "AGENT_PRODUCTS=$AGENT_PRODUCTS"
  "AGENT_BROWSER_CDP_ENABLED=false"
  "AGENTWORKS_BROWSER_SESSION_PREFIX=dominion"
  "AGENTWORKS_BROWSER_STAGING_NAMESPACE=dominion"
  "AGENTWORKS_MCP_BUILDER_ENABLED=true"
  "AGENTWORKS_CREW_SHARED_ROOT=on"
  "DISPLAY_TIME_ZONE=America/New_York"
  # Every product for administrators, as on Excellence and Confida; others get what users.json gives them.
  "AGENTWORKS_ADMIN_ONLY_PRODUCT_SURFACES="
  "AGENTWORKS_PRODUCTS_AVAILABLE_TO_ALL=work,code,relays"
  # Per-user Linux accounts, opt-in as on Confida: a person who holds a slot runs shell commands as it, everyone
  # else (and the trading workflow) is unchanged. Own accounts dm01..dm05, launcher, config and table:
  # deploy/common/provision-slots.sh with PRODUCT=dominion SLOT_PREFIX=dm SLOT_COUNT=5.
  "AGENTWORKS_SLOTS=optin"
  "AGENTWORKS_SLOT_PREFIX=dm"
  "AGENTWORKS_SLOTCTL=/usr/local/libexec/agentworks/dominion/slotctl"
  "AGENTWORKS_SLOTCTL_CONFIG=/usr/local/libexec/agentworks/dominion/slotctl.json"
  "AGENTWORKS_SLOTS_FILE=/etc/agentworks/dominion/slots.json"
)
SLOTS_ENABLED=true
AGENT_EXTRA_ENV=(
  "TMPDIR=/srv/dominion/state/agent-tmp"
  "TMUX_TMPDIR=/tmp"
  "AGENTWORKS_MCP_STATE_DIR=/srv/dominion/state/mcp"
)
# Drop-ins the old Dominion deploy wrote; the shared deploy manages the same settings in zz-deploy-managed.conf.
REMOVE_DEPLOY_DROPINS=("20-disable-cdp.conf" "30-durable-mcp.conf")
RUNTIME_CONFIG_REQUIRED_SNIPPETS=(
  "cdpEnabled: false"
  "gatewayUrl: \"https://trader.tectonicmarkets.com\""
  "defaultProductSurface: \"dominion\""
  "appName: \"Dominion\""
)
