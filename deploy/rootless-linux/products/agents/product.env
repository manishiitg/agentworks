# agents.excellencetechnologies.in: a Code-only AgentWorks deployment on the
# shared rootless host (next to Dominion, Confida and SparkQuill). Read by
# deploy/rootless-linux/*.sh on both machines; see deploy/rootless-linux/README.md.
# One-time host setup (account, units, Caddy site): deploy/rootless-linux/setup-agents-host.sh.

PRODUCT=agents
HOST_IP="${HOST_IP:-116.202.210.102}"
SSH_PORT="${SSH_PORT:-2299}"
SSH_KEY_PATH="${SSH_KEY_PATH:-$HOME/.ssh/id_ed25519}"
DOMAIN="agents.excellencetechnologies.in"

AGENT_PORT=24000
WORKSPACE_PORT=24001
VAULT_ENABLED=true
VAULT_PORT=24003
GATEWAY_ADDR="127.0.0.1:24080"

# Code only (docs/design/code_product.md). Crew ("work") and other products are given per person in users.json
# (`products`; administrators have every product) and are NOT available to all: AGENTWORKS_PRODUCTS_AVAILABLE_TO_ALL
# below stays `code`. AGENT_PRODUCTS is not passed to this deployment's services (it is unset there), so it does not
# gate anything; do not rely on it. No server-wide coding agent or
# model and no server CLI login: each person signs their own coding CLI in
# (Setup), and each Code chat uses that.
AGENT_PRODUCTS="code"
AGENT_MAX_TURNS=100

# The CLI programs only (no login): each person's own login runs them.
# The shared deployer installs and updates every supported coding CLI.
PIN_NODE_VERSION=""

# No Workflow Builder or playbook catalog on a Code-only deployment.
COPY_PLAYBOOKS=false
RUN_WORKFLOW_BUILDER_MIGRATION=false

EXPECTED_PUBLIC_URL="https://agents.excellencetechnologies.in"
PUBLIC_HEALTH_STATUS=200
PUBLIC_CHECK_PATHS=("/login")

# Per-person Google sign-in (Supabase), admins from ADMIN_USERS in the .env.
# Code is open to every signed-in account an admin lets in.
EXTRA_ENV=(
  # PLAT-364: every coding CLI runs under the Landlock lock, with Full CLI inside it.
  # Per-user Linux accounts (docs/DECISIONS.md, "Per-user Linux accounts"): provisioned by
  # deploy/common/provision-slots.sh as root; commands run as the caller's slot.
  "AGENTWORKS_SLOTS=on"
  # Coding CLIs as the user's own account, canary first (see AGENTWORKS_SLOT_CLI_USERS): one user id, then everyone.
  "AGENTWORKS_SLOT_CLI=on"
  "AGENTWORKS_SLOT_CLI_USERS=8d66a20d-11b2-4f4a-93a8-e6e42c603f33"
  "AGENT_BROWSER_CDP_ENABLED=false"
  "AGENTWORKS_BROWSER_SESSION_PREFIX=agents"
  "AGENTWORKS_BROWSER_STAGING_NAMESPACE=agents"
  "AGENTWORKS_ADMIN_ONLY_PRODUCT_SURFACES="
  "AGENTWORKS_PRODUCTS_AVAILABLE_TO_ALL=code"
  # Outside MCP connections may edit Builder plans/code and write Relays (owner 2026-10-05). Still per person: Builder needs
  # write access to the workflow on every call, Relay authoring needs the account's Relays product (PLAT-487).
  "AGENTWORKS_MCP_BUILDER_ENABLED=true"
  # New Crews are created at the shared Crew/ root, from the UI too (owner 2026-10-05, PLAT-442).
  "AGENTWORKS_CREW_SHARED_ROOT=on"
  # Docker for users' Code projects is the service account's own rootless daemon, never the host's root daemon
  # (the account is not in the `docker` group). 990 is the agents account's uid on this host.
  "DOCKER_HOST=unix:///run/user/990/docker.sock"
)
# Per-user accounts (see EXTRA_ENV AGENTWORKS_SLOTS): put the tmux front-end first in PATH.
SLOTS_ENABLED=true
REQUIRED_PERSISTED_ENV_KEYS=(SUPABASE_URL SUPABASE_ANON_KEY AUTH_SECRET ACCESS_PASSWORD ADMIN_USERS)
RUNTIME_CONFIG_REQUIRED_SNIPPETS=(
  "cdpEnabled: false"
  "enabledProductSurfaces: [\"code\", \"work\", \"relays\", \"mcp-gateway\"]"
  "defaultProductSurface: \"code\""
)

# Agent-only settings.
AGENT_EXTRA_ENV=(
  # Server temp files (launch scripts, CLI configs, bridge tokens) stay out
  # of the shared /tmp, which coding CLIs may write; tmux stays in /tmp.
  "TMPDIR=/srv/agents/state/agent-tmp"
  "TMUX_TMPDIR=/tmp"
)
