# Citymall (agents.citymall.live): its own AWS Mumbai host, prepared by setup-citymall-host.sh (see citymall.md).
# Read by deploy.sh on the laptop and by build-and-activate.sh on the host. PLAT-710.
#
# SSH: port 22 only admits the Hetzner build host, so the laptop connects through it with ProxyJump. The jump only
# forwards the TCP connection: the key (~/Downloads/manish.pem) stays on the laptop. Never copy that key (or one derived
# from it) to the Hetzner host, this box, the repository or a build, and never use agent forwarding (-A).

PRODUCT=citymall
HOST_IP="${HOST_IP:-13.206.199.45}"
SSH_PORT="${SSH_PORT:-22}"
SSH_KEY_PATH="${SSH_KEY_PATH:-$HOME/Downloads/manish.pem}"
SSH_JUMP="${SSH_JUMP:-root@116.202.210.102:2299}"
DOMAIN="agents.citymall.live"

# Root host preparation (packages, accounts, units, nginx), idempotent, run on every deploy through the ubuntu account's sudo.
HOST_SETUP_SCRIPT="setup-citymall-host.sh"
HOST_SETUP_USER="ubuntu"

# This host cannot read the build host's /srv/_builds: it downloads the shared build from GitHub (agentworks-builds) and
# checks its manifest hash; without a published release the build is streamed through the laptop instead. Nothing is
# compiled here (2 CPUs).
PREBUILT_DELIVERY=fetch

# 2 CPUs / 7 GB: keep the activation job and each Pi process small.
ACTIVATE_MEMORY_MAX=3G
ACTIVATE_CPU_QUOTA=150%

AGENT_PORT=25000
WORKSPACE_PORT=25001
VAULT_ENABLED=true
VAULT_PORT=25003
GATEWAY_ADDR="127.0.0.1:25080"

# Goals (agentworks), Crew (work), Code, Brain (knowledgebase) and Vault (mcp-gateway). Relays and the rest are off.
AGENT_PRODUCTS="agentworks,work,code,mcp-gateway,knowledgebase"
AGENT_MAX_TURNS=100

# Agy reads the service GEMINI_API_KEY in that mode; there is none here, and Pi is the only offered agent anyway.
AGY_AUTH_MODE=auto

PIN_NODE_VERSION="24.21.0"
PIN_NODE_SHA256="fd8e59d5a511510f6a298afb548f18c7d2b1be404d8b4a27d94fbe49f56cb2d6"

COPY_PLAYBOOKS=true
PLAYBOOK_SMOKE_PATH="agentic-engineering-platform/browser-qa/basic-browser-setup/playbook.json"
RUN_WORKFLOW_BUILDER_MIGRATION=false
PERSIST_MCP_STATE=true

EXPECTED_PUBLIC_URL="https://agents.citymall.live"
# DNS for agents.citymall.live and ports 80/443 are not open yet (PLAT-710): the public checks are skipped and the deploy
# checks the loopback services and nginx on 127.0.0.1:80. Set PUBLIC_CHECKS=true once certbot has issued the certificate.
PUBLIC_CHECKS=false
PUBLIC_HEALTH_STATUS=200
PUBLIC_CHECK_PATHS=("/login")
LOCAL_PROXY_CHECK_URL="http://127.0.0.1:80/login"

# Present in .env before a deploy goes live. The sign-in settings (SUPABASE_URL, SUPABASE_ANON_KEY, ADMIN_USERS) are
# added by the owner once the Google sign-in exists (citymall.md); until then nobody can sign in through the UI.
REQUIRED_PERSISTED_ENV_KEYS=(AUTH_SECRET ACCESS_PASSWORD CITYMALL_API_KEY PUBLIC_URL)

EXTRA_ENV=(
  "AGENT_BROWSER_CDP_ENABLED=false"
  "AGENTWORKS_BROWSER_SESSION_PREFIX=citymall"
  "AGENTWORKS_BROWSER_STAGING_NAMESPACE=citymall"
  "MULTI_USER_MODE=true"
  "DISPLAY_TIME_ZONE=Asia/Kolkata"
  "AGENTWORKS_ADMIN_ONLY_PRODUCT_SURFACES="
  "AGENTWORKS_PRODUCTS_AVAILABLE_TO_ALL=agentworks,work,code,knowledgebase"
  "AGENTWORKS_MCP_BUILDER_ENABLED=true"
  "AGENTWORKS_CREW_SHARED_ROOT=on"
  # Pi is the only coding agent, on Citymall's own gateway. The key is CITYMALL_API_KEY in .env (owner-only); the Pi
  # adapter passes it to each Pi as CITYMALL_API_KEY and stages pi-agent/ (no key in it) into every session (PLAT-711).
  "SUPPORTED_LLM_PROVIDERS=pi-cli"
  "AGENT_PROVIDER=pi-cli"
  "AGENT_MODEL=citymall/gpt-6-luna"
  "PI_CLI_AGENT_TEMPLATE_DIR=/srv/citymall/current/configs/pi-agent"
  "PI_CLI_NODE_MAX_OLD_SPACE_MB=1536"
  # Confined CLIs (Landlock) may only exec what is granted: the managed CLI prefix and its Node. Without it Pi died at
  # start with "exec: /srv/citymall/tools/bin/pi: Permission denied" (status 126).
  "SANDBOX_EXTRA_SYSTEM_PATHS=/srv/citymall/tools/bin:/srv/citymall/tools/lib/node_modules:/srv/citymall/tools/node/bin:/srv/citymall/tools/node-v24.21.0"
  # Sign-in: Google through Supabase. Only people in the user directory may sign in (owner 2026-10-08: the
  # four first admins, no domain-wide rule); an admin adds everyone else.
  "AUTH_PROVIDERS=supabase-google"
  # The gateway (nginx -> 127.0.0.1:25080) serves the frontend and checks each request's user token.
  "GATEWAY_DISABLE_PASSWORD_GATE=true"
  "AGENT_API_URL=http://127.0.0.1:25000"
  "FRONTEND_DIR=/srv/citymall/current/frontend"
  "APP_NAME=Citymall"  # no spaces: systemd Environment= splits on them
)

REMOVE_DEPLOY_DROPINS=()

RUNTIME_CONFIG_REQUIRED_SNIPPETS=(
  "cdpEnabled: false"
  "gatewayUrl: \"https://agents.citymall.live\""
  "enabledProductSurfaces: [\"agentworks\", \"work\", \"code\", \"mcp-gateway\", \"knowledgebase\"]"
  "defaultProductSurface: \"agentworks\""
)

AGENT_EXTRA_ENV=(
  "TMPDIR=/srv/citymall/state/agent-tmp"
  "TMUX_TMPDIR=/tmp"
  "AGENTWORKS_PLAYBOOKS_DIR=/srv/citymall/current/playbooks"
  "AGENTWORKS_MCP_STATE_DIR=/srv/citymall/state/mcp"
  "GOMEMLIMIT=2GiB"
)
