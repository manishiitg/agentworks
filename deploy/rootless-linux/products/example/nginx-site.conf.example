# Example nginx site in front of an AgentWorks gateway (adapt the names and ports; the real per-server file lives in the
# private deployments repository).
#
# Log only the path, never query strings (which can contain signed file or
# WebSocket credentials). Header-authenticated event streams need no URL token.
# log_format belongs to http{}; sites-enabled files are included there.
log_format example_paths '$remote_addr - $remote_user [$time_local] "$request_method $uri $server_protocol" '
                         '$status $body_bytes_sent "$http_user_agent"';

map $http_upgrade $example_connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    server_name agents.example.com;
    access_log /var/log/nginx/access.log example_paths;

    location / {
        proxy_pass http://127.0.0.1:25080;   # the gateway, never the agent port
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $example_connection_upgrade;
        proxy_set_header Host $host;
        proxy_buffering off;                  # server-sent events
        proxy_read_timeout 3600s;
    }
}
