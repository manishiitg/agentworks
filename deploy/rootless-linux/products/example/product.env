# Example product config: copy this folder into the PRIVATE deployments repository as products/<name>/ and fill it in.
# Real server configs never live in this public repository (see deploy/README.md).
# Example deployment config, read by deploy/rootless-linux/*.sh on both the
# triggering machine and the remote host. See deploy/rootless-linux/README.md.

PRODUCT=example
HOST_IP="${HOST_IP:-203.0.113.10}"
SSH_PORT="${SSH_PORT:-2299}"
SSH_KEY_PATH="${SSH_KEY_PATH:-$HOME/.ssh/id_ed25519}"
DOMAIN="agents.example.com"

AGENT_PORT=23000
WORKSPACE_PORT=23001
GATEWAY_ADDR="127.0.0.1:23080"

# Fixed single-product deployment: one workspace (Chats/Example), one
# locked provider/model -- not a generic multi-surface AgentWorks instance.
AGENT_PRODUCTS="example"
AGENT_PROVIDER="codex-cli"
AGENT_MODEL="gpt-6-luna"
AGENT_MAX_TURNS=100

# The shared deployer installs and updates every supported coding CLI.

# The managed browser runtime requires Node >=24. Use the same verified LTS
# release as server C, installed under this product's own tools directory.
PIN_NODE_VERSION="24.21.0"
PIN_NODE_SHA256="fd8e59d5a511510f6a298afb548f18c7d2b1be404d8b4a27d94fbe49f56cb2d6"

# Example has no admin-only / multi-surface product gating and no
# Workflow/playbook catalog -- it is a fixed single-workspace product, not a
# generic AgentWorks instance.
COPY_PLAYBOOKS=false
RUN_WORKFLOW_BUILDER_MIGRATION=false
# One-time move of retired personal secrets into the Chats/Example box.
RUN_PRODUCT_SECRETS_MIGRATION=true

# Not yet configured on this deployment (no PUBLIC_URL in /srv/example/.env
# today, so no MCP OAuth callback depends on it yet). Leave unset so the
# deploy skips the check instead of failing on a pre-existing gap; set this
# once PUBLIC_URL is added to the remote .env for OAuth-based MCP servers.
EXPECTED_PUBLIC_URL=""

# Extra systemd Environment= lines applied to both example-agent and
# example-workspace via one managed drop-in. Everything already in
# /srv/example/.env (WORKSPACE_DOCS_PATH, AGENT_BROWSER_SHARED_PROFILE,
# SANDBOX_EXTRA_SYSTEM_PATHS, AGENT_BROWSER_NAMESPACE, ...) stays there,
# untouched -- this only adds/overrides what the deploy itself must guarantee.
EXTRA_ENV=(
  # PLAT-364: every coding CLI runs under the Landlock lock, with Full CLI inside it.
  "AGENT_BROWSER_CDP_ENABLED=false"
  # The shared Example family workspace stays under the fixed gateway
  # identity; only these two Google accounts can obtain a gateway session.
  "GATEWAY_SSO_ONLY=true"
  "GATEWAY_SSO_ALLOWED_EMAILS=owner@example.com"
  "GATEWAY_SSO_REDIRECT_URL=https://agents.example.com/auth/google/callback"
)

# Stored once in /srv/example/.env; fail before activation if either is
# missing, rather than replacing a working password gateway with one that
# cannot start Google sign-in. The Supabase project's redirect allowlist must
# include https://agents.example.com/auth/google/callback as well.
REQUIRED_PERSISTED_ENV_KEYS=(GATEWAY_SSO_SUPABASE_URL GATEWAY_SSO_SUPABASE_ANON_KEY)

# Agent-only settings.
AGENT_EXTRA_ENV=(
  # Server temp files (launch scripts, CLI configs, bridge tokens) stay out
  # of the shared /tmp, which coding CLIs may write; tmux stays in /tmp.
  "TMPDIR=/srv/example/state/agent-tmp"
  "TMUX_TMPDIR=/tmp"
)
