[Unit]
Description=Video Studio workspace API (user service)
ConditionPathIsMountPoint=/data/video-studio
Wants=docker.service
After=docker.service

[Service]
EnvironmentFile=%h/video-studio/.env
Environment=HOME=%h
Environment=PATH=%h/video-studio/slots/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=AGENT_BROWSER_CDP_ENABLED=false
Environment=AGENT_BROWSER_CLI_DIR=%h/.local/bin
Environment=DOCKER_HOST=unix:///run/user/%U/docker.sock
WorkingDirectory=%h/video-studio/current
ExecStart=%h/video-studio/current/bin/video-studio-workspace server --port 8080 --docs-dir /data/video-studio/docs
StandardOutput=append:%h/video-studio/logs/workspace.log
StandardError=append:%h/video-studio/logs/workspace.log
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
