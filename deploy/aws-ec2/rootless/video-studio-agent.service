[Unit]
Description=Video Studio agent API (user service)
After=network-online.target
ConditionPathIsMountPoint=/data/video-studio

[Service]
EnvironmentFile=%h/video-studio/.env
Environment=HOME=%h
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=AGENT_PRODUCTS=video-studio,work,code
Environment=AGENTWORKS_MCP_STATE_DIR=%h/.local/state/agentworks/mcp
Environment=AGENTWORKS_STATE_ROOT=%h/video-studio/state
Environment=AGENT_BROWSER_CDP_ENABLED=false
Environment=MCP_BRIDGE_BINARY=%h/video-studio/current/bin/mcpbridge
# The release packages the SPA and the report-preview runtime together here.
# The agent's read-only preview endpoint must resolve the same static root.
Environment=STATIC_DIR=%h/video-studio/current/frontend
# The public origin, for URLs the server hands to third parties: the MCP
# connector OAuth redirect (deriveOAuthRedirectURI) and login redirects.
# Without it the agent guesses from X-Forwarded-* headers two proxies deep.
Environment=PUBLIC_URL=https://video.realtrainingsys.com
# RTS never emails invitations (it shares the Supabase project); admins copy them.
# PLAT-364: coding CLIs run under the Landlock launcher, confined to their
# folder, for every user.
Environment=AGENTWORKS_CLI_LANDLOCK=on
# Full CLI (Claude's own shell and file edits) inside that lock, for every user.
Environment=AGENTWORKS_CLI_FULL=on
# The server's temp files (launch scripts, per-launch CLI configs, bridge
# tokens) go to a private folder: coding CLIs may write the shared /tmp.
# tmux keeps its socket in /tmp so running chats stay reachable.
Environment=TMPDIR=%h/video-studio/state/agent-tmp
Environment=TMUX_TMPDIR=/tmp
# %h/.config is root-owned on this host (the bootstrap wrote the systemd user
# units there), so tools that keep state under XDG config -- cursor-agent
# does -- get a writable location instead of EACCES.
Environment=XDG_CONFIG_HOME=%h/.local/state/xdg-config
WorkingDirectory=%h/video-studio/current
ExecStart=%h/video-studio/current/bin/video-studio-agent server --host 0.0.0.0 --port 8000 --log-level info --mcp-config %h/video-studio/current/configs/mcp_servers_video_studio.json --provider ${AGENT_PROVIDER} --model ${AGENT_MODEL} --max-turns 100
StandardOutput=append:%h/video-studio/logs/agent.log
StandardError=append:%h/video-studio/logs/agent.log
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
