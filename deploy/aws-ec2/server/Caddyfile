{
    http_port 8080
    https_port 8443
    # HTTP/2 is required: every open chat holds a long-lived SSE stream, and
    # HTTP/1.1's six-connections-per-origin cap queues all other requests
    # behind them (PLAT-268). h3 is omitted because UDP 443 is not published.
    servers {
        protocols h1 h2
    }

    # The browser puts its sign-in token in the URL of event-stream and
    # websocket requests; keep it out of the logs.
    log {
        format filter {
            wrap console
            fields {
                request>uri query {
                    replace token REDACTED
                }
            }
        }
    }
}

__DOMAIN__ {
    encode zstd gzip
    reverse_proxy host.docker.internal:8090
}
