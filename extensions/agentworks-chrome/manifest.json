{
  "manifest_version": 3,
  "name": "AgentWorks Browser Bridge",
  "version": "0.4.5",
  "description": "Connect shared Chrome or Edge tabs to your AgentWorks Code projects, Crews and workflows.",
  "minimum_chrome_version": "125",
  "permissions": [
    "debugger",
    "tabs",
    "tabGroups",
    "storage",
    "alarms"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "AgentWorks browser connection",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png"
    }
  },
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "128": "icon-128.png"
  }
}
